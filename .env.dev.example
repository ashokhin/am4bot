# Copy to .env.dev and fill in -- see docker-compose.dev.yml's header for
# the full quick-start. Never commit .env.dev itself (already gitignored).

# openssl rand -base64 32
SECRETS_MASTER_KEY=
JWT_SIGNING_KEY=

# Any string -- just needs to match between apiserver and orchestrator,
# which this compose file wires automatically once set here once.
ORCHESTRATOR_TOKEN=dev-orchestrator-token

# Absolute path on the HOST, bind-mounted at the identical path into the
# orchestrator container -- see docker-compose.dev.yml's header for why it
# must be absolute and identical on both sides. Created automatically if
# it doesn't exist.
COMPOSE_NODES_DIR=/tmp/am4bot-dev-nodes

# Only relevant if you actually provision a node and want ambot's
# container to run something other than the published image (e.g. a
# locally built one from the current branch: `docker build -t
# am4bot-dev .` then AMBOT_IMAGE=am4bot-dev, AMBOT_PULL_POLICY=never).
# AMBOT_IMAGE=ashokhin/am4bot:latest
# AMBOT_PULL_POLICY=always
