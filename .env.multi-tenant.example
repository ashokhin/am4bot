# Copy to .env.multi-tenant and fill in with real values -- see
# docker-compose.multi-tenant.yml.example's header for the full
# quick-start. Never commit the filled-in .env.multi-tenant.

# See docs/multi-tenant-hosting.md's "Secrets and key management" section
# before generating these -- losing SECRETS_MASTER_KEY specifically is
# PERMANENT, UNRECOVERABLE data loss for every game/VPN password it
# encrypts (there is no reset/recovery path). JWT_SIGNING_KEY is much
# lower-stakes -- losing/rotating it just logs everyone out at once.
# Generate real ones, e.g.:
#   openssl rand -base64 32   # SECRETS_MASTER_KEY -- back this one up
#   openssl rand -base64 64   # JWT_SIGNING_KEY (see internal/auth.GenerateSigningKey)
# (or internal/secrets.GenerateKey() / internal/auth.GenerateSigningKey()
# from a throwaway Go program, if you'd rather not shell out to openssl.)
# Store them wherever you manage secrets -- not in this file if it ever
# leaves your machine -- and back SECRETS_MASTER_KEY up independently of
# the Postgres volume: a database backup without this key alongside it is
# not a usable backup, just an unreadable pile of ciphertext.
SECRETS_MASTER_KEY=
JWT_SIGNING_KEY=

# Real Postgres password for the am4bot role this compose file creates.
POSTGRES_PASSWORD=

# Shared secret between apiserver and orchestrator -- any sufficiently
# random string, e.g. `openssl rand -hex 32`. Must match on both sides;
# this compose file wires it to both automatically once set here.
ORCHESTRATOR_TOKEN=

# Absolute path on the HOST with real disk space -- every provisioned
# node's rendered compose files AND each node's own container filesystem
# live under it. Bind-mounted into orchestrator at the identical path
# (see docker-compose.multi-tenant.yml.example's own comment on why).
COMPOSE_NODES_DIR=/var/lib/am4bot/nodes

# A label for nodes.target_host -- purely informational until multi-host
# provisioning exists (see migrations/0001_init.sql's design note).
TARGET_HOSTS=prod-host-1

# Leave these four as-is unless you're running a local/private build
# instead of the published images (see
# docker-compose.multi-tenant.dev.yml.example for that dev-only flow --
# it doesn't apply here).
# AMBOT_IMAGE=ashokhin/am4bot:latest
# AMBOT_PULL_POLICY=always
# CONTROLPLANE_IMAGE=ashokhin/am4bot-controlplane:latest
# CONTROLPLANE_PULL_POLICY=always

# Only if you're running your own Prometheus and want orchestrator to
# maintain a file_sd targets file for it (see
# cmd/orchestrator/prometheus_sd.go and docs/multi-tenant-hosting.md's
# "Metrics" section) -- leave unset to disable this entirely.
# PROMETHEUS_SD_FILE=/var/lib/am4bot/prometheus-sd/targets.json
